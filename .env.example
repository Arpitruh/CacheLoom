HOST=127.0.0.1
PORT=8080
MAX_KEYS=10000
# Start with memory. Switch to postgres when you need values to survive restarts.
CACHELOOM_STORAGE=memory
# Uncomment for PostgreSQL, then run npm run migrate once.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cacheloom
CACHELOOM_API_KEYS={"demo":"replace-this-with-a-random-secret-at-least-32-characters"}

# Shared PostgreSQL limit in postgres mode; per-instance limit in memory mode.
CACHELOOM_PROJECT_RPM=600
# During rotation, pass an array of old and new keys for the same project.
# CACHELOOM_API_KEYS={"demo":["old-secret-of-at-least-32-characters","new-secret-of-at-least-32-characters"]}
