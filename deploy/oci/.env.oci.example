# Copy to .env.oci on the VM. NEVER commit the real file.
CACHELOOM_DOMAIN=cacheloom-staging.example.com
CACHELOOM_STORAGE=postgres
CACHELOOM_PROJECT_RPM=600
# Use the pooled connection string appropriate for your private Neon staging DB,
# with TLS validation enabled by the provider's connection settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate independently for staging: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CACHELOOM_API_KEYS={"staging":"REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SECRET"}
